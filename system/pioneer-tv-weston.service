[Unit]
Description=Pioneer TV display (Weston + Chromium)
After=systemd-user-sessions.service plymouth-quit-wait.service pioneer-tv-daemon.service user@1000.service
Wants=pioneer-tv-daemon.service user@1000.service
Conflicts=getty@tty1.service
RequiresMountsFor=/run

[Service]
Type=simple
User=pi
Group=pi
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/home/pi
# Weston 14's atomic DRM path misbehaves on both Pi generations: VideoCore IV
# aborts on the cursor plane, and on a Pi 4 the atomic commit fails with EINVAL
# on every frame (60 "repaint-flush failed" a second) and Weston falls back
# each time, which stutters. The legacy modesetting path works on both.
Environment=WESTON_DISABLE_ATOMIC=1
ExecStart=/usr/bin/weston --config=/home/pi/.config/weston.ini
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
