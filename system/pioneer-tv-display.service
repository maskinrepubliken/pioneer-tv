[Unit]
Description=Pioneer TV display (labwc + Chromium + overlay)
After=systemd-user-sessions.service plymouth-quit-wait.service pioneer-tv-daemon.service user@1000.service
Wants=pioneer-tv-daemon.service user@1000.service
# pioneer-tv-weston: the display before labwc, stopped on a box changing over.
Conflicts=getty@tty1.service pioneer-tv-weston.service
RequiresMountsFor=/run

[Service]
Type=simple
User=pi
Group=pi
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/home/pi
ExecStart=/usr/bin/labwc -C /opt/pioneer-tv/system/labwc -S /opt/pioneer-tv/system/session.sh
Restart=always
# Back off when it keeps failing (2 s, growing to a minute), so a crash loop
# does not run 77,000 times overnight; a single crash still restarts at once.
RestartSec=2
RestartSteps=6
RestartMaxDelaySec=60

[Install]
WantedBy=graphical.target
